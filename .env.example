# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Optional for Vercel overrides; defaults to firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Resend Email Configuration (Server-side only)
# Resend API Key from https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Fixed test recipient email address (authorized email on Resend dev mode)
RESEND_TEST_EMAIL="your-test-email@example.com"

# Administrator Firebase Authentication UID for test email sending permission
# Multiple UIDs can be separated by commas (e.g. "uid1,uid2")
ADMIN_UID="your-firebase-user-uid"

# Firebase Admin SDK Service Account Credentials (Server-side only)
# Needed for elevated backend operations: createUser, emailVerified: true, server-side Firestore
# Paste the full service account private key JSON from Firebase Console > Project Settings > Service Accounts
# In Vercel / server env, you can paste the JSON string directly:
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"clipsort-7adfb","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@clipsort-7adfb.iam.gserviceaccount.com"}'

# Server OTP Hash Secret Key (Optional; defaults to RESEND_API_KEY if omitted)
AUTH_SECRET="clipsort-secure-otp-secret-key-2026"
