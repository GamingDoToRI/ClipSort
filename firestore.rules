rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Videos collection partitioned by Firebase Auth UID
    match /videos/{videoId} {
      // Authenticated users can read their own bookmarks or legacy bookmarks
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        !('userId' in resource.data) ||
        resource.data.userId == null
      );

      // Authenticated users can create bookmarks tagged with their own UID
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid
      );

      // Authenticated users can update or delete their own bookmarks or claim legacy bookmarks
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        !('userId' in resource.data) ||
        resource.data.userId == null
      );

      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        !('userId' in resource.data) ||
        resource.data.userId == null
      );
    }

    // System email verification tokens collection (Strictly server-side access only via Admin SDK)
    match /_system_email_verifications/{docId} {
      allow read, write: if false;
    }
  }
}
