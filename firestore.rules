rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connection test document (read-only health check)
    match /test/{docId} {
      allow read: if docId == 'connection';
      allow write: if false;
    }

    // Videos collection strictly partitioned by authenticated Firebase Auth UID
    match /videos/{videoId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.id is string &&
        request.resource.data.url is string &&
        request.resource.data.title is string;

      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;

      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // System email verification tokens collection (Strictly server-side access only via Admin SDK)
    match /_system_email_verifications/{docId} {
      allow read, write: if false;
    }

    // Customer support inquiries collection (Strictly server-side access only via Admin SDK)
    match /inquiries/{docId} {
      allow read, write: if false;
    }

    // Account unification & linking tables (Strictly server-side access only via Admin SDK)
    match /account_links/{uid} {
      allow read, write: if false;
    }

    match /user_accounts/{uid} {
      allow read, write: if false;
    }
  }
}
